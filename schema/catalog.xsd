<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ham Radio Trainer - catalog schema, version 1

  Deliberate design constraints:
    * plain text XML, no encryption, no obfuscation, no binary containers
    * hand-editable in any editor and diffable in git
    * stable element names (English) so that tooling stays language neutral

  The schema is shaped around the machine readable question catalog of the
  Bundesnetzagentur (DL-DE-BY-2.0). See data/catalogs/ for imported catalogs.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>
      Root element "catalog" describes one question catalog for exactly one
      German amateur radio examination class (N, E or A).
    </xs:documentation>
  </xs:annotation>

  <!-- ==================== catalog ==================== -->

  <xs:element name="catalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="metadata"/>
        <xs:element ref="parts"/>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ==================== metadata ==================== -->

  <xs:element name="metadata">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title"       type="xs:string"/>
        <xs:element name="examClass"   type="examClassType"/>
        <xs:element name="examId"      type="xs:string"/>
        <xs:element name="authority"   type="xs:string"/>
        <xs:element name="catalogVersion" type="xs:string"/>
        <xs:element name="validFrom"   type="xs:date"/>
        <xs:element name="validUntil"  type="xs:date" minOccurs="0"/>
        <xs:element name="language"    type="languageType" minOccurs="0"/>
        <!-- Default penalty per wrong answer when a question carries no
             "points". The Bundesnetzagentur catalog does not publish penalty
             points, so an imported catalog leaves them at 0. -->
        <xs:element name="defaultPoints" type="xs:nonNegativeInteger" minOccurs="0"/>
        <xs:element name="sourceUrl"   type="xs:anyURI" minOccurs="0"/>
        <!-- SPDX style licence identifier of the question text, e.g.
             "DL-DE-BY-2.0". Required whenever the catalog derives from an
             external source, because attribution is a licence condition. -->
        <xs:element name="license"     type="xs:string" minOccurs="0"/>
        <!-- Mandatory source notice, verbatim, when "license" is set. -->
        <xs:element name="attribution" type="xs:string" minOccurs="0"/>
        <!-- True as soon as anybody edited the catalog after the import.
             Attribution licences require that changes are indicated. -->
        <xs:element name="modifiedSinceSource" type="xs:boolean" minOccurs="0"/>
        <xs:element name="notes"       type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- N = Novize, E = Einsteiger, A = Allgemein -->
  <xs:simpleType name="examClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="N"/>
      <xs:enumeration value="E"/>
      <xs:enumeration value="A"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="languageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="de"/>
      <xs:enumeration value="en"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ==================== parts ==================== -->

  <xs:element name="parts">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="part" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- One part is one amtlicher Prüfungsteil: V, B, N, E or A. A certificate of
       class N covers V, B and N; class E covers V, B, N and E; class A covers
       all five. -->
  <xs:element name="part">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="selection" type="selectionType" minOccurs="0"/>
        <xs:element ref="section" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id"    type="xs:ID" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="order" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ==================== sections ==================== -->

  <xs:element name="section">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="chapters" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id"    type="xs:ID" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="order" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Prüfungsumfang of a Prüfungsteil, as fixed by Amtsblatt-Verfügung 29/2024:
       25 questions per sheet, one point each, passed at 19 points, so six wrong
       answers are tolerated. "minutes" is the time limit for that sheet. -->
  <xs:complexType name="selectionType">
    <xs:attribute name="questions"   type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="errorPoints" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="passScore"   type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="minutes"     type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <!-- ==================== chapters ==================== -->

  <xs:element name="chapters">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="chapter" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="chapter">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="questions" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id"    type="xs:ID" use="required"/>
      <xs:attribute name="title" type="xs:string" use="required"/>
      <xs:attribute name="order" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ==================== questions ==================== -->

  <xs:element name="questions">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="question" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="question">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="text"        type="xs:string"/>
        <xs:element ref="answers"/>
        <xs:element name="image"       type="relativePathType" minOccurs="0"/>
        <xs:element name="explanation" type="xs:string" minOccurs="0"/>
        <xs:element ref="history" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id"     type="xs:ID" use="required"/>
      <xs:attribute name="order"  type="xs:positiveInteger" use="required"/>
      <!-- "single": exactly one correct answer, "multiple": one or more -->
      <xs:attribute name="type"   type="questionType" use="required"/>
      <!-- Penalty charged per wrong answer. 0 means unknown; the effective
           value then falls back to metadata/defaultPoints. -->
      <xs:attribute name="points" type="xs:nonNegativeInteger" use="optional" default="0"/>
      <!-- Gesperrt: question is excluded from generated papers -->
      <xs:attribute name="locked" type="xs:boolean" use="optional" default="false"/>
      <!-- "latex" marks text and answer texts that contain $...$ markup -->
      <xs:attribute name="textFormat" type="textFormatType" use="optional"
                    default="plain"/>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="questionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="single"/>
      <xs:enumeration value="multiple"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="textFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="plain"/>
      <xs:enumeration value="latex"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="answers">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="answer" minOccurs="2" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="answer">
    <xs:complexType>
      <!-- Either text or a picture, never neither: the Bundesnetzagentur
           catalog contains questions whose four answers are pure images. -->
      <xs:attribute name="id"      type="xs:ID" use="required"/>
      <xs:attribute name="text"    type="xs:string" use="optional"/>
      <xs:attribute name="image"   type="relativePathType" use="optional"/>
      <xs:attribute name="correct" type="xs:boolean" use="required"/>
      <xs:attribute name="order"   type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- ==================== revision history ==================== -->

  <xs:element name="history">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="addedOn"   type="xs:date"/>
        <xs:element name="changedOn" type="xs:date" minOccurs="0"/>
        <xs:element name="retiredOn" type="xs:date" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ==================== simple types ==================== -->

  <!-- Relative, forward-slash separated, never absolute and never escaping. -->
  <xs:simpleType name="relativePathType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9._\-/]+"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>